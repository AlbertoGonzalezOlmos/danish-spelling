<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/child_background"
    android:padding="32dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/btn_child_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_child_mode"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="48dp"
        android:text="@string/child_mode"
        android:textSize="24sp"
        android:backgroundTint="@color/child_primary"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_media_play"
        app:iconSize="48dp"
        app:iconGravity="top"
        app:layout_constraintBottom_toTopOf="@id/btn_parent_mode"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintWidth_max="400dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_parent_mode"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginTop="24dp"
        android:text="@string/parent_mode"
        android:textSize="24sp"
        android:backgroundTint="@color/md_theme_secondary"
        app:cornerRadius="16dp"
        app:icon="@android:drawable/ic_menu_manage"
        app:iconSize="48dp"
        app:iconGravity="top"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_child_mode"
        app:layout_constraintWidth_max="400dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
